# core.autocrlf is on for this checkout, which is right for a Windows machine
# and wrong for anything that has to run on Linux. A shell script checked out
# with CRLF fails on its own shebang - `/usr/bin/env bash\r: no such file` -
# and a systemd unit with CRLF is rejected silently, both of which are
# discovered on the server rather than here.
*.sh text eol=lf
*.service text eol=lf
*.env text eol=lf

# Written by a Linux container, read by a Linux engine.
docker-compose.yml text eol=lf
