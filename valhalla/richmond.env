# Shared settings for the Richmond routing engine.
#
# Sourced by every script in ./scripts and by the systemd unit, so the box you
# develop on and the box you deploy to are configured from one file. Override
# any of these in the environment to point a script somewhere else.

# The area to keep from the state extract.
#
# The dial tops out at a 100 minute walk, which at the 3.69 km/h the proxy
# pins is about 6.2 km. This box reaches roughly 15 km from downtown in every
# direction, so even a walk that starts at the edge of the preset origins has
# graph well past where it could possibly go. Clipping tighter would make
# routes near the boundary quietly wrong rather than obviously missing.
: "${RICHMOND_BBOX_LEFT:=-77.61}"
: "${RICHMOND_BBOX_BOTTOM:=37.40}"
: "${RICHMOND_BBOX_RIGHT:=-77.26}"
: "${RICHMOND_BBOX_TOP:=37.68}"

# Where the extract, the clipped extract, the graph and the config live.
# Gitignored: about 1 GB for the state extract, a fraction of that once clipped.
: "${VALHALLA_DIR:=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)}"
: "${VALHALLA_DATA_DIR:=${VALHALLA_DIR}/data}"

: "${STATE_EXTRACT_URL:=https://download.geofabrik.de/north-america/us/virginia-latest.osm.pbf}"
: "${STATE_EXTRACT:=${VALHALLA_DATA_DIR}/virginia-latest.osm.pbf}"
: "${RICHMOND_EXTRACT:=${VALHALLA_DATA_DIR}/richmond.osm.pbf}"

: "${VALHALLA_CONFIG:=${VALHALLA_DATA_DIR}/valhalla.json}"
: "${VALHALLA_TILE_DIR:=${VALHALLA_DATA_DIR}/tiles}"

# Loopback only. The engine must be reachable through the app's proxy, which
# is what pins pedestrian costing and the Richmond bounds; anything that talks
# to it directly is unmetered and unconstrained.
: "${VALHALLA_HOST:=127.0.0.1}"
: "${VALHALLA_PORT:=8002}"

# The ladder is every minute from 5 to 100, so the engine has to allow 100
# contours in one query and a 100 minute one. These must match the
# VALHALLA_MAX_CONTOURS the app is configured with.
: "${VALHALLA_MAX_CONTOURS:=100}"
: "${VALHALLA_MAX_TIME_CONTOUR:=100}"
