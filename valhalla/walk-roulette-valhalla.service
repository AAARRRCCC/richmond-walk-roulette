# The routing engine, as a service.
#
# Install:
#   sudo cp valhalla/walk-roulette-valhalla.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now walk-roulette-valhalla
#
# Edit User and the two paths if the checkout does not live in /srv. Nothing
# else here is machine-specific.
#
# Logs: journalctl -u walk-roulette-valhalla -f
# Health, once the app is up: curl -s localhost:5173/api/health

[Unit]
Description=Valhalla routing engine for Walk Roulette
Documentation=https://valhalla.github.io/valhalla/
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=valhalla
Group=valhalla

# The config carries the tile paths and the listen address, both written by
# scripts/build-graph.sh. The trailing 1 is the worker thread count; walking
# queries are cheap and the box has better uses for its cores.
ExecStart=/usr/bin/valhalla_service /srv/walk-roulette/valhalla/data/valhalla.json 1

Restart=on-failure
RestartSec=5s

# The engine reads tiles and answers questions. It has no reason to write
# anywhere, reach the rest of the filesystem, or gain privileges.
ReadOnlyPaths=/srv/walk-roulette/valhalla/data
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6
RestrictNamespaces=true
LockPersonality=true
MemoryDenyWriteExecute=true

[Install]
WantedBy=multi-user.target
