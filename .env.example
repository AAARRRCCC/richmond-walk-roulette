# Google Maps API key with the Routes API enabled.
# Optional — without it, the map shows a stylized curved line instead of a real walking route.
#
# Setup:
#   1. Create a Google Cloud project: https://console.cloud.google.com
#   2. Enable the "Routes API" for the project
#   3. Create an API key and restrict it to:
#        - HTTP referrers: your deployed domain (e.g. https://walk.example.com/*)
#        - APIs: Routes API
#   4. Copy this file to `.env.local` and paste the key below
#
# .env.local is gitignored. Vite inlines this value at build time.
VITE_GOOGLE_MAPS_API_KEY=

# Cloudflare Web Analytics beacon token. Optional.
# When set, main.tsx injects the cookie-free CF beacon script tag.
# When unset (dev, preview, non-CF hosts), no analytics ship.
#
# To get a token: Cloudflare dashboard -> Analytics -> Web Analytics ->
# "+ Add a site" -> copy the token value from the script-tag snippet.
VITE_CF_ANALYTICS_TOKEN=
